# =========================================
# AutoPost backend environment (backend/.env)
# =========================================
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Frontend has its own separate file at frontend/.env.local (Next.js convention).

# -----------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------
# IMPORTANT: Use the SESSION POOLER URL (port 5432), not the Transaction Pooler (6543).
# Reason: Alembic uses Postgres advisory locks which hang under transaction-mode pooling.
# Find this URL at: Supabase Dashboard → Project Settings → Database → "Session Pooler".
# Format:
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------
# Supabase Auth
# -----------------------------------------
# Settings → API → "Project URL" and "anon public" + "service_role secret".
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL — leave blank for modern asymmetric-key projects (we verify via JWKS).
# Only fill if your project is on legacy HS256 ("Legacy JWT Secret" tab in the dashboard).
SUPABASE_JWT_SECRET=

# -----------------------------------------
# Groq (LLM)
# -----------------------------------------
# Get from https://console.groq.com → API Keys. No credit card needed.
GROQ_API_KEY=
# llama-3.3-70b / llama-3.1-8b are decommissioned on Groq 2026-08-16. Primary
# is qwen3.6-27b (best founder-voice; client auto-sets reasoning_effort=none for
# qwen/ models). Fast is llama-4-scout (extraction; generous free-tier limits).
GROQ_MODEL_PRIMARY=qwen/qwen3.6-27b
GROQ_MODEL_FAST=meta-llama/llama-4-scout-17b-16e-instruct

# -----------------------------------------
# LinkedIn (single app — personal posting)
# -----------------------------------------
# This is App #1 with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" enabled.
# In MVP we post as the authenticated member (the company-branded personal account).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/linkedin/callback
# 2026 OIDC + member-posting scopes:
LINKEDIN_SCOPES=openid,profile,email,w_member_social
# LinkedIn API version header (YYYYMM). Bump every few months as LinkedIn rotates versions.
LINKEDIN_API_VERSION=202604

# (Deferred — only fill if you ever register a legal entity and Community Management API
#  is approved on a SECOND LinkedIn dev app.)
# LINKEDIN_ORG_CLIENT_ID=
# LINKEDIN_ORG_CLIENT_SECRET=
# LINKEDIN_ORG_URN=urn:li:organization:XXXXXXX

# -----------------------------------------
# Reddit (script-type app)
# -----------------------------------------
# Create at https://www.reddit.com/prefs/apps → "create app" → type: script.
# Use http://localhost as the redirect URI in Reddit's form (unused for script-type).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AutoPost/0.1 (by /u/your-handle)

# -----------------------------------------
# App
# -----------------------------------------
# Generate APP_SECRET_KEY (one-time, do not rotate after first use):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000
TIMEZONE=UTC
LOG_LEVEL=INFO

# -----------------------------------------
# Scheduler cron expressions
# -----------------------------------------
RETRIEVAL_CRON=0 */6 * * *
ANALYTICS_CRON=0 * * * *

# -----------------------------------------
# Rendering / brand
# -----------------------------------------
# Displayed in the footer strap of every rendered visual.
BRAND_NAME=Nestwhirr


SUPABASE_STORAGE_BUCKET=autopost-assets


# -----------------------------------------
# Cloudflare Creds
# -----------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# When true, append the dark/editorial brand style to every AI-image prompt so
# generations composite into the brand-wrap. Default false = Flux picks the
# palette/lighting that fit the subject (no forced black framing).
AI_IMAGE_BRAND_STYLE=false

# -----------------------------------------
# Bluesky (single app — personal posting)
# -----------------------------------------

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=


# -----------------------------------------
# Mastodon (federated — OAuth client registered dynamically per instance)
# -----------------------------------------

MASTODON_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/mastodon/callback
MASTODON_CLIENT_NAME=Nestwhirr AutoPost
MASTODON_SCOPES=read write


# -----------------------------------------
# Meta
# -----------------------------------------

META_APP_ID= 
META_APP_SECRET= 

# Threads OAuth (use these as client_id / client_secret in the Threads OAuth flow)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/threads/callback
THREADS_SCOPES=threads_basic,threads_content_publish
THREADS_API_VERSION=v1.0
# Keep false until Meta App Review approves threads_basic + threads_content_publish.
# When false: the connect flow + the /generate platform picker hide Threads.
PLATFORM_THREADS_ENABLED=false

# Instagram OAuth (Instagram Login flow, NOT Facebook Login — the lightweight
# path that skips the Facebook-Page link). Requires a Creator/Business account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_API_VERSION=v21.0
# Keep false until Meta App Review approves the Instagram content-publish scopes.
# When false: the connect flow + the /generate platform picker hide Instagram.
PLATFORM_INSTAGRAM_ENABLED=false

# Instagram OAuth — check dashboard under Instagram product → API setup
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
